# Copy to .env for local; set these in Railway dashboard for production.
#
# DATABASE_URL — Railway Postgres plugin URL (postgres:// is auto-normalized)
# CORS_ORIGINS — comma-separated, include your Vercel URL
# SEED_ON_STARTUP — true (default) seeds catalog/rewards if empty

DATABASE_URL=sqlite:///./mvp_category_quest.db
CORS_ORIGINS=http://localhost:3000
SEED_ON_STARTUP=true
